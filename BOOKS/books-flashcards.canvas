    {
      "id": "card_53",
      "type": "text",
      "text": "<div style=\"display:flex; flex-direction:column; gap:8px; height:100%; font-family:system-ui,-apple-system,sans-serif; padding:6px;\"><div style=\"text-align:center;\"><img src=\"https://covers.openlibrary.org/b/id/8749519-L.jpg\" width=\"130\" style=\"border-radius:6px; object-fit:cover; box-shadow:0 4px 14px rgba(0,0,0,0.45); display:block; margin:0 auto;\"/></div><div>  <div style=\"font-size:14px; font-weight:700; color:#f0f0f0;    margin-bottom:3px; line-height:1.3;\">The Art of Seduction</div>  <div style=\"font-size:11.5px; color:#aaa; margin-bottom:4px;\"></div>  <div style=\"display:flex; gap:5px; align-items:center; flex-wrap:wrap;\">    <span style=\"font-size:10.5px; background:#1e1e30; color:#7ec8e3;          border-radius:3px; padding:2px 7px;\">Seduction</span>    <span style=\"font-size:10.5px; background:#1e1e30; color:#aaa;          border-radius:3px; padding:2px 7px;\">To Read</span>    <span style=\"font-size:11px; color:#f0c040;\"></span>  </div>  <div style=\"margin-top:7px; font-size:12px; color:#7ec8e3; border-bottom:1px solid #333;        padding-bottom:3px;\">Key Takeaways</div>  <ul style=\"padding-left:16px; margin:0 0 4px;\"><li style=\"margin-bottom:5px; font-size:12.5px; color:#d8d8d8; line-height:1.4;\">The siren** — using beauty and mystery to captivate</li><li style=\"margin-bottom:5px; font-size:12.5px; color:#d8d8d8; line-height:1.4;\">The rake** — danger and emotional intensity as attraction</li><li style=\"margin-bottom:5px; font-size:12.5px; color:#d8d8d8; line-height:1.4;\">The natural** — authenticity as the most powerful aphrodisiac</li></ul>  <p style=\"font-size:11px; color:#5a9fc2; margin:0;\">👆 tap to flip</p></div></div>",
